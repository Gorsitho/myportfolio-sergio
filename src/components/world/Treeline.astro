---
/**
 * A single-colour row of pixel trees standing on a strip of ground.
 * Trees are generated from a seed so the forest is identical on every build.
 */
import { seededRandom } from '../../lib/pixel';

interface Props {
  color: string;
  height: number;
  seed: number;
  kind?: 'pine' | 'round' | 'mixed';
  /** Height of the ground strip under the trees. */
  ground?: number;
  /** Size of one art pixel. */
  unit?: number;
  /** Tree height range as a fraction of the layer height. */
  minTree?: number;
  maxTree?: number;
  /** Average horizontal gap between trees (in view units). */
  spacing?: number;
  bottom?: number;
  class?: string;
}

const VIEW_WIDTH = 2400;
const {
  color,
  height,
  seed,
  kind = 'pine',
  ground = 16,
  unit = 6,
  minTree = 0.45,
  maxTree = 0.95,
  spacing = 70,
  bottom = 0,
  class: className,
} = Astro.props;

const random = seededRandom(seed);
const snap = (value: number) => Math.round(value / unit) * unit;
const rect = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}Z`;

function pine(cx: number, base: number, treeHeight: number): string {
  const trunk = unit * 2;
  const crownHeight = snap(treeHeight - trunk);
  const halfWidth = snap(treeHeight * 0.28);
  let d = rect(cx - unit / 2, base - trunk, unit, trunk);
  for (let y = 0; y < crownHeight; y += unit) {
    // Wider "tiers" every few rows give the classic stepped pine look.
    const progress = y / crownHeight;
    const tier = (y / unit) % 4;
    const width = Math.max(unit, snap(halfWidth * progress * 2 * (1 - tier * 0.08)));
    d += rect(cx - width / 2, base - trunk - crownHeight + y, width, unit);
  }
  return d;
}

function round(cx: number, base: number, treeHeight: number): string {
  const trunk = unit * 3;
  const radius = snap((treeHeight - trunk) / 2);
  const centerY = base - trunk - radius;
  let d = rect(cx - unit, base - trunk - unit, unit * 2, trunk + unit);
  for (let dy = -radius; dy < radius; dy += unit) {
    const half = snap(Math.sqrt(Math.max(0, radius * radius - (dy + unit / 2) ** 2)));
    if (half > 0) d += rect(cx - half, centerY + dy, half * 2, unit);
  }
  return d;
}

const base = height - ground;
let d = rect(0, base, VIEW_WIDTH, ground);
for (let x = random() * spacing; x < VIEW_WIDTH; x += spacing * (0.5 + random())) {
  const treeHeight = snap(height * (minTree + random() * (maxTree - minTree)));
  const shape = kind === 'mixed' ? (random() > 0.5 ? 'pine' : 'round') : kind;
  d += shape === 'pine' ? pine(snap(x), base, treeHeight) : round(snap(x), base, treeHeight);
}
---

<svg
  class:list={['layer', className]}
  style={`--layer-height:${height}px;--layer-bottom:${bottom}px`}
  viewBox={`0 0 ${VIEW_WIDTH} ${height}`}
  preserveAspectRatio="xMidYMax slice"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  <path d={d} fill={color}></path>
</svg>
