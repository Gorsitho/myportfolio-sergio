---
/** A stepped mountain / hill silhouette spanning the full width of a scene. */
import { ridgePath } from '../../lib/pixel';

interface Props {
  color: string;
  /** Height of the layer in CSS pixels. */
  height: number;
  seed: number;
  low?: number;
  high?: number;
  step?: number;
  peaks?: number;
  /** Distance from the bottom of the scene. */
  bottom?: number;
  class?: string;
}

const VIEW_WIDTH = 2400;
const { color, height, seed, low = 0.3, high = 0.9, step = 8, peaks = 3, bottom = 0, class: className } =
  Astro.props;
const d = ridgePath({ width: VIEW_WIDTH, height, step, low, high, seed, peaks });
---

<svg
  class:list={['layer', className]}
  style={`--layer-height:${height}px;--layer-bottom:${bottom}px`}
  viewBox={`0 0 ${VIEW_WIDTH} ${height}`}
  preserveAspectRatio="xMidYMax slice"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  <path d={d} fill={color}></path>
</svg>
