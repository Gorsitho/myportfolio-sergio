---
/**
 * The traveler who follows the visitor through the world (wide screens only).
 * Walks while the page scrolls, idles when it stops, turns around when
 * scrolling up, and comments on each new area. Purely decorative.
 */
import PixelSprite from './PixelSprite.astro';
import { travelerFrames, travelerPalette } from '../../art/traveler';
import { regions } from '../../data/sections';

const lines = Object.fromEntries(regions.map((region) => [region.id, region.travelerLine]));
---

<div class="traveler" data-traveler data-hidden="true" data-lines={JSON.stringify(lines)} aria-hidden="true">
  <p class="traveler__bubble" data-traveler-bubble></p>
  <PixelSprite frames={travelerFrames} palette={travelerPalette} scale={5} class="traveler__sprite anim-idle" />
  <span class="traveler__shadow"></span>
</div>

<script>
  const traveler = document.querySelector<HTMLElement>('[data-traveler]');
  const sprite = traveler?.querySelector<HTMLElement>('.traveler__sprite');
  const bubble = traveler?.querySelector<HTMLElement>('[data-traveler-bubble]');

  if (traveler && sprite && bubble) {
    const lines: Record<string, string> = JSON.parse(traveler.dataset.lines ?? '{}');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const STOP_DELAY = 160;
    const BUBBLE_TIME = 2800;
    let lastY = window.scrollY;
    let stopTimer = 0;
    let bubbleTimer = 0;

    const setWalking = (walking: boolean) => {
      sprite.classList.toggle('anim-walk', walking);
      sprite.classList.toggle('anim-idle', !walking);
    };

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        traveler.dataset.facing = y < lastY ? 'left' : 'right';
        lastY = y;
        if (reducedMotion.matches) return;
        setWalking(true);
        window.clearTimeout(stopTimer);
        stopTimer = window.setTimeout(() => setWalking(false), STOP_DELAY);
      },
      { passive: true },
    );

    document.addEventListener('region:enter', (event) => {
      const { id } = (event as CustomEvent<{ id: string }>).detail;
      // The hero has its own traveler by the campfire.
      traveler.dataset.hidden = String(id === 'start');
      const line = lines[id];
      if (!line) return;
      bubble.textContent = line;
      bubble.dataset.visible = 'true';
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(() => delete bubble.dataset.visible, BUBBLE_TIME);
    });
  }
</script>

<style>
  .traveler {
    display: none;
  }

  /* Only where the left margin is wide enough to never cover content. */
  @media (min-width: 90rem) {
    .traveler {
      position: fixed;
      bottom: var(--space-6);
      left: calc((100vw - var(--content-width)) / 4 - 40px);
      z-index: var(--z-traveler);
      display: flex;
      flex-direction: column;
      align-items: center;
      pointer-events: none;
      transition:
        opacity var(--duration-base),
        transform var(--duration-base) var(--ease-out);
    }
  }

  .traveler[data-hidden='true'] {
    opacity: 0;
    transform: translateY(12px);
  }

  .traveler[data-facing='left'] :global(.traveler__sprite) {
    transform: scaleX(-1);
  }

  .traveler__shadow {
    width: 56px;
    height: 8px;
    margin-top: -4px;
    background: rgb(0 0 0 / 0.35);
    border-radius: 50%;
  }

  .traveler__bubble {
    position: relative;
    margin-bottom: var(--space-3);
    padding: var(--space-2) var(--space-3);
    max-width: 11rem;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    line-height: 1.3;
    text-align: center;
    color: var(--color-ink);
    background: var(--color-parchment);
    box-shadow:
      0 0 0 3px var(--color-surface-edge),
      4px 5px 0 0 rgb(0 0 0 / 0.3);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--duration-base),
      transform var(--duration-base) var(--ease-out);
  }

  .traveler__bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 9px;
    height: 9px;
    background: var(--color-parchment);
    box-shadow: 3px 3px 0 0 var(--color-surface-edge);
    transform: translateX(-50%) rotate(45deg);
  }

  .traveler__bubble[data-visible] {
    opacity: 1;
    transform: none;
  }
</style>
