---
/**
 * The Quest Log: site navigation that tracks progress through the page.
 * Wide screens: a fixed panel in the right margin.
 * Smaller screens: a top bar with a toggle that opens the list.
 */
import { regions } from '../../data/sections';
import { profile } from '../../data/profile';
---

<header class="hud">
  <nav class="quest-log" aria-label="Quest log" data-quest-log>
    <div class="quest-log__bar">
      <a class="quest-log__home" href="#start">{profile.name}</a>
      <button
        class="quest-log__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="quest-log-list"
        data-quest-toggle
      >
        <span class="quest-log__toggle-label">Quest log</span>
        <span class="quest-log__current" data-quest-current>{regions[0].label}</span>
        <span class="quest-log__chevron" aria-hidden="true"></span>
      </button>
    </div>

    <div class="quest-log__panel" id="quest-log-list">
      <p class="quest-log__title" aria-hidden="true">Quest log</p>
      <ol class="quest-log__list" role="list">
        {
          regions.map((region, index) => (
            <li>
              <a
                href={`#${region.id}`}
                class="quest-log__link"
                data-nav-link={region.id}
                data-time={region.timeOfDay}
                data-state={index === 0 ? 'current' : 'upcoming'}
                aria-current={index === 0 ? 'location' : undefined}
              >
                <span class="quest-log__marker" aria-hidden="true">
                  <svg viewBox="0 0 7 6" shape-rendering="crispEdges" focusable="false">
                    <path d="M6 0h1v2H6zM5 2h1v1H5zM4 3h1v1H4zM3 4h1v1H3zM1 3h1v1H1zM2 4h1v2H2zM0 2h1v1H0z" />
                  </svg>
                </span>
                <span>{region.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="quest-log__time" aria-hidden="true">
        Day 1 · <span data-quest-time>{regions[0].timeOfDay}</span>
      </p>
    </div>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-quest-log]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-quest-toggle]');
  const currentLabel = document.querySelector<HTMLElement>('[data-quest-current]');
  const timeLabel = document.querySelector<HTMLElement>('[data-quest-time]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links.map((link) => document.getElementById(link.dataset.navLink ?? ''));

  let activeIndex = -1;

  function setActive(index: number) {
    if (index === activeIndex || index < 0) return;
    activeIndex = index;

    links.forEach((link, i) => {
      link.dataset.state = i < index ? 'done' : i === index ? 'current' : 'upcoming';
      if (i === index) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });

    const link = links[index];
    if (currentLabel) currentLabel.textContent = link.textContent?.trim() ?? '';
    if (timeLabel) timeLabel.textContent = link.dataset.time ?? '';
    document.dispatchEvent(new CustomEvent('region:enter', { detail: { id: link.dataset.navLink } }));
  }

  // A thin horizontal band ~40% down the viewport decides which region is active.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) setActive(sections.indexOf(entry.target as HTMLElement));
      }
    },
    { rootMargin: '-40% 0px -59% 0px' },
  );
  sections.forEach((section) => section && observer.observe(section));

  function setOpen(open: boolean) {
    if (!nav || !toggle) return;
    nav.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  links.forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (nav && !nav.contains(event.target as Node)) setOpen(false);
  });
</script>

<style>
  .hud {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-hud);
    pointer-events: none;
  }

  .quest-log {
    pointer-events: auto;
    font-family: var(--font-display);
  }

  /* ── Compact bar (default, below 1440px) ── */
  .quest-log__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: var(--hud-height);
    padding-inline: var(--gutter);
    background: rgb(8 11 22 / 0.82);
    backdrop-filter: blur(6px);
    border-bottom: var(--px) solid var(--color-surface-edge);
    box-shadow: 0 2px 0 0 rgb(201 178 138 / 0.35);
  }

  .quest-log__home {
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .quest-log__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    background: var(--color-surface-raised);
    border: 2px solid var(--color-frame);
    cursor: pointer;
  }

  .quest-log__toggle-label {
    color: var(--color-accent-strong);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .quest-log__chevron {
    width: 8px;
    height: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--duration-fast);
  }

  [data-open] .quest-log__chevron {
    transform: translateY(2px) rotate(-135deg);
  }

  .quest-log__panel {
    position: absolute;
    top: calc(var(--hud-height) + var(--space-2));
    right: var(--gutter);
    min-width: 14rem;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: var(--px) solid var(--color-frame);
    box-shadow:
      0 0 0 var(--px) var(--color-surface-edge),
      6px 8px 0 0 rgb(0 0 0 / 0.4);
  }

  :global(.js) .quest-log:not([data-open]) .quest-log__panel {
    display: none;
  }

  .quest-log__title {
    display: none;
  }

  .quest-log__list {
    display: grid;
    gap: var(--space-1);
  }

  .quest-log__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-1);
    color: var(--color-muted);
    text-decoration: none;
    font-size: var(--text-base);
  }

  .quest-log__link:hover {
    color: var(--color-text);
  }

  .quest-log__link[data-state='current'] {
    color: var(--color-accent-strong);
  }

  .quest-log__link[data-state='done'] {
    color: var(--color-text);
  }

  .quest-log__marker {
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    flex: none;
    border: 2px solid currentColor;
  }

  .quest-log__marker svg {
    width: 10px;
    fill: var(--color-night);
    visibility: hidden;
  }

  [data-state='current'] .quest-log__marker {
    background: var(--color-accent);
    border-color: var(--color-accent-strong);
    box-shadow: 0 0 0 2px rgb(242 165 65 / 0.35);
  }

  [data-state='done'] .quest-log__marker {
    background: var(--color-teal);
    border-color: var(--color-teal);
  }

  [data-state='done'] .quest-log__marker svg {
    visibility: visible;
  }

  .quest-log__time {
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 2px dashed rgb(201 178 138 / 0.35);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 30rem) {
    .quest-log__toggle-label {
      display: none;
    }

    .quest-log__panel {
      left: var(--gutter);
    }
  }

  /* ── Full quest log panel in the right margin (1440px+) ── */
  @media (min-width: 90rem) {
    .quest-log__bar {
      display: none;
    }

    .quest-log__panel,
    :global(.js) .quest-log:not([data-open]) .quest-log__panel {
      display: block;
      top: var(--space-5);
      right: var(--space-4);
      min-width: 11.5rem;
      padding: var(--space-4);
    }

    .quest-log__title {
      display: block;
      margin-bottom: var(--space-3);
      font-size: var(--text-sm);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-sunlight);
    }
  }
</style>
